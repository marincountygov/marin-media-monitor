# Copy to .env for local development only. In production these are set as
# GitHub Actions repository secrets (Settings > Secrets and variables >
# Actions), never committed. See README.md "Environment variables".

# YouTube Data API v3 key. Without it, the youtube source shows "error" on
# /sources and contributes no items.
YOUTUBE_API_KEY=

# Reddit OAuth app credentials (client-credentials grant). Only used if
# config/sources.yaml's reddit.enabled is set to true.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
